# What a project brings along so that the CLI and MCP can talk to Gradula.
# This file is the LIST of names — the values live in .gradula.env (ignored).

# Where Gradula runs.
GRADULA_URL=https://gradula.mundula.app

# The project key. Valid for EXACTLY ONE project, shown once in plain text,
# revocable at any time. Not in Git.
GRADULA_TOKEN=

# Who is acting when a machine writes on behalf of a person. A claim, not an
# ID card — it goes into the chronicle as written.
GRADULA_AKTEUR=

# Only for the service itself (not for a project):
# GRADULA_DB_URL=postgres://gradula:…@db:5432/gradula
# GRADULA_ADMIN_TOKEN=            32+ random characters; without it there is no admin door
